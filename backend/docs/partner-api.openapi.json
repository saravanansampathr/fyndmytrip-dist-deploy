{
 "openapi": "3.0.3",
 "info": {
  "title": "FyndMyTrip Partner API",
  "version": "1.0.0",
  "description": "Search, book, pay and cancel flights, hotels, buses, cabs, insurance, cruises and activities. Authenticate with POST /token, then send Authorization: Bearer <access_token>. Every call is limited to your credential's requests per minute (X-RateLimit-* headers). Browser calls must come from your credential's allowed domain."
 },
 "servers": [
  {
   "url": "https://api-demo.fyndmytrip.in/api/partner/v1"
  }
 ],
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer"
   }
  }
 },
 "paths": {
  "/token": {
   "post": {
    "summary": "Get an access token",
    "description": "Exchange your client_id and client_secret for a bearer token valid for one hour.",
    "tags": [
     "Auth"
    ],
    "responses": {
     "200": {
      "description": "access_token, token_type, expires_in"
     },
     "401": {
      "description": "Invalid credentials"
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object"
       },
       "example": {
        "client_id": "<client_id>",
        "client_secret": "<client_secret>"
       }
      }
     }
    }
   }
  },
  "/me": {
   "get": {
    "summary": "Your account",
    "description": "Account name, enabled services, rate limit and wallet balance.",
    "tags": [
     "Account"
    ],
    "responses": {
     "200": {
      "description": "OK"
     },
     "401": {
      "description": "Missing or expired token"
     },
     "403": {
      "description": "Service not enabled, or origin not allowed"
     },
     "422": {
      "description": "Validation error"
     },
     "429": {
      "description": "Rate limit exceeded"
     }
    },
    "security": [
     {
      "bearer": []
     }
    ]
   }
  },
  "/flights/search": {
   "post": {
    "summary": "Search flights",
    "description": "Same request body as the portal search. Prices are what your account pays (gross_amount), with your margin rules applied.",
    "tags": [
     "Flights"
    ],
    "responses": {
     "200": {
      "description": "OK"
     },
     "401": {
      "description": "Missing or expired token"
     },
     "403": {
      "description": "Service not enabled, or origin not allowed"
     },
     "422": {
      "description": "Validation error"
     },
     "429": {
      "description": "Rate limit exceeded"
     }
    },
    "security": [
     {
      "bearer": []
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object"
       },
       "example": {
        "origin": "DEL",
        "destination": "DXB",
        "departure_date": "2026-12-20",
        "adults": 2,
        "children": 0,
        "infants": 1
       }
      }
     }
    }
   }
  },
  "/flights/bookings": {
   "post": {
    "summary": "Hold a flights booking",
    "description": "Holds an offer from search for your travellers. Returns the booking with status held and total_amount.",
    "tags": [
     "Flights"
    ],
    "responses": {
     "201": {
      "description": "Held booking"
     },
     "422": {
      "description": "Validation error or price changed"
     }
    },
    "security": [
     {
      "bearer": []
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object"
       },
       "example": {
        "legs": [
         {
          "supplier_code": "MOCKAIR",
          "external_id": "<from search>",
          "segments": [
           "<from search>"
          ]
         }
        ],
        "travel_date": "2026-12-20",
        "passengers": [
         {
          "title": "Mr",
          "first_name": "Asha",
          "last_name": "Rao",
          "passenger_type": "adult",
          "dob": "1990-01-01",
          "document_type": "passport",
          "document_number": "Z1234567",
          "passport_expiry_date": "2030-01-01",
          "passport_country": "IN"
         }
        ]
       }
      }
     }
    }
   }
  },
  "/flights/bookings/{booking}/confirm": {
   "post": {
    "summary": "Pay and confirm a flights booking",
    "description": "Pays the full amount from your prepaid wallet and confirms/tickets with the supplier. 402 when the wallet balance is too low.",
    "tags": [
     "Flights"
    ],
    "responses": {
     "200": {
      "description": "Confirmed or ticketed booking"
     },
     "402": {
      "description": "Wallet balance too low"
     },
     "409": {
      "description": "Booking is not held"
     }
    },
    "security": [
     {
      "bearer": []
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object"
       },
       "example": {}
      }
     }
    },
    "parameters": [
     {
      "name": "booking",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer"
      }
     }
    ]
   }
  },
