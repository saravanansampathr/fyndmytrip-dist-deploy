APP_NAME=FyndMyTrip
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database ---
# Production / staging: MySQL 8.0 as per the System Architecture Document.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fyndmytrip
DB_USERNAME=fyndmytrip
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

# --- Tenancy ---
TENANCY_DEFAULT_MAX_SUB_TENANT_DEPTH=5

# --- Mail (transactional email; tenant-overridable, see notification_gateway_configs) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="no-reply@fyndmytrip.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Platform-default payment gateways (BYOG per-tenant overrides live in DB, encrypted) ---
PAYMENT_DEFAULT_GATEWAY=razorpay
RAZORPAY_KEY=
RAZORPAY_SECRET=

# --- Platform-default SMS / WhatsApp (tenant-overridable, see notification_gateway_configs) ---
SMS_DEFAULT_PROVIDER=msg91
WHATSAPP_DEFAULT_PROVIDER=gupshup

# --- AI Gateway microservice (Python FastAPI, see System Architecture Document §5) ---
AI_GATEWAY_BASE_URL=http://localhost:8100
AI_GATEWAY_TOKEN=

# --- TBO / Tek Travels Flight API (see backend/docs/supplier-integration-notes.md) ---
# No self-service sandbox: TBO issues UserName/Password only after agency
# registration + onboarding by apiintegrationteam@tbo.com. Leave blank until
# you have those; the TBO adapter throws a clear SupplierException without them.
TBO_API_BASE_URL=http://api.tektravels.com/BookingEngineService_Air/AirService.svc/rest
TBO_CLIENT_ID=ApiIntegrationNew
TBO_USERNAME=
TBO_PASSWORD=

# --- TripJack Flight API (see backend/docs/supplier-integration-notes.md) ---
# apitest.tripjack.com is TripJack's real test host, but the `apikey` for it
# is still only issued after TripJack's partner team onboards you — leave
# blank until you have one.
TRIPJACK_API_BASE_URL=https://apitest.tripjack.com
TRIPJACK_API_KEY=
